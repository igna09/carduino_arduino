# Reindirizzamento log su USB Nativa della SuperMini
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
# CONFIG_ESP_CONSOLE_UART_NUMBER=-1
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Ottimizzazione RAM: No Bluetooth per ora
CONFIG_BT_ENABLED=n

# Sicurezza Automotive e Gestione Crash
# CONFIG_ESP_SYSTEM_PANIC_REBOOT=y
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_BROWNOUT_DET=y
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_7=y

# C++ Clean Code (No eccezioni per preservare RAM)
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n

# Risparmio energetico automatico
CONFIG_PM_ENABLE=n

CONFIG_TWAI_ISR_IN_IRAM=y

# Abilita la tabella delle partizioni predefinita a livello di configurazione
CONFIG_PARTITION_TABLE_SINGLE_APP=y

# Specifica all'SDK la dimensione reale della Flash (2MB)
CONFIG_ESPTOOLPY_FLASHSIZE_2MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="2MB"